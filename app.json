{
  "expo": {
    "name": "Stalwise",
    "slug": "stalwise",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stalwise",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.kcdesigns.stalwise",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kcdesigns.stalwise",
      "adaptiveIcon": {
        "backgroundColor": "#12285F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12285F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Stalwise uses your photos so you can add pictures to a horse's file and a logo for your business.",
          "cameraPermission": "Stalwise uses the camera so you can take photos for a horse's file.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
